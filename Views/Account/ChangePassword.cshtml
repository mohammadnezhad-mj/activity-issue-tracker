@{
    ViewData["Title"] = "تغییر رمز عبور";
}

<div class="min-h-screen bg-gradient-to-br from-gray-50 to-gray-100">
    <!-- Header -->
    <div class="bg-white shadow-sm border-b border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                <div>
                    <h1 class="text-3xl font-bold text-gray-900 flex items-center gap-3">
                        <i class="bi bi-key text-indigo-600"></i>
                        تغییر رمز عبور
                    </h1>
                </div>
                <div class="flex flex-wrap gap-3">
                    <a href="@Url.Action("Dashboard", "Home")" class="inline-flex items-center gap-2 px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-800 font-medium rounded-lg transition-colors duration-200">
                        <i class="bi bi-arrow-right"></i>
                        <span>بازگشت</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        @if (ViewBag.ErrorMessage != null)
        {
            <div class="mb-6 bg-red-50 border-r-4 border-red-500 text-red-800 px-4 py-3 rounded-lg flex items-center gap-3 shadow-sm">
                <i class="bi bi-exclamation-triangle-fill text-xl"></i>
                <div class="flex-1">@ViewBag.ErrorMessage</div>
            </div>
        }

        <form asp-action="ChangePassword" method="post" class="bg-white rounded-xl shadow-lg p-6 md:p-8">
            @Html.AntiForgeryToken()
            
            <div class="space-y-6">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2 flex items-center gap-2">
                        <i class="bi bi-lock text-indigo-600"></i>
                        رمز عبور فعلی <span class="text-red-500">*</span>
                    </label>
                    <input type="password" name="currentPassword" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent" required autocomplete="current-password" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2 flex items-center gap-2">
                        <i class="bi bi-key text-indigo-600"></i>
                        رمز عبور جدید <span class="text-red-500">*</span>
                    </label>
                    <input type="password" name="newPassword" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent" required autocomplete="new-password" minlength="1" maxlength="100" />
                    <p class="mt-1 text-xs text-gray-500">حداکثر 100 کاراکتر</p>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2 flex items-center gap-2">
                        <i class="bi bi-key-fill text-indigo-600"></i>
                        تکرار رمز عبور جدید <span class="text-red-500">*</span>
                    </label>
                    <input type="password" name="confirmPassword" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent" required autocomplete="new-password" minlength="1" maxlength="100" />
                </div>

                <div class="flex flex-col sm:flex-row justify-end gap-3 pt-6 border-t border-gray-200">
                    <a href="@Url.Action("Dashboard", "Home")" class="px-6 py-2 bg-gray-200 hover:bg-gray-300 text-gray-800 font-medium rounded-lg transition-colors duration-200 text-center">
                        انصراف
                    </a>
                    <button type="submit" class="px-6 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-lg transition-colors duration-200 shadow-md hover:shadow-lg">
                        <i class="bi bi-check-circle ml-2"></i>تغییر رمز عبور
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
    document.querySelector('form').addEventListener('submit', function(e) {
        var newPassword = document.querySelector('input[name="newPassword"]').value;
        var confirmPassword = document.querySelector('input[name="confirmPassword"]').value;
        
        if (newPassword !== confirmPassword) {
            e.preventDefault();
            alert('رمز عبور جدید و تکرار آن یکسان نیستند.');
            return false;
        }
    });
</script>
