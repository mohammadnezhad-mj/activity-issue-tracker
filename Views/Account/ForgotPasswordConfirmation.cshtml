@{
    ViewData["Title"] = "لینک بازیابی رمز عبور";
    Layout = null;
    var resetToken = ViewBag.ResetToken as string;
    var message = ViewBag.Message as string ?? "";
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes" />
    <meta name="theme-color" content="#667eea" />
    <title>@ViewData["Title"]</title>
    <script src="~/lib/tailwind/tailwind.min.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" asp-append-version="true" />
</head>
<body class="min-h-screen bg-gradient-to-br from-indigo-500 via-purple-500 to-pink-500 flex items-center justify-center p-5">
    <div class="bg-white rounded-3xl shadow-2xl p-8 md:p-10 w-full max-w-lg animate-fade-in">
        <div class="text-center mb-6">
            <i class="bi bi-envelope-check text-6xl text-indigo-600 mb-4"></i>
            <h2 class="text-2xl font-bold text-gray-900 mb-2">بازیابی رمز عبور</h2>
            <p class="text-gray-600">@message</p>
        </div>

        @if (!string.IsNullOrEmpty(resetToken))
        {
            var resetUrl = Url.Action("ResetPassword", "Account", new { token = resetToken }, Context.Request.Scheme);
            <div class="mb-6 p-4 bg-indigo-50 rounded-xl border border-indigo-200">
                <p class="text-sm text-gray-700 mb-3">برای تنظیم رمز عبور جدید روی لینک زیر کلیک کنید (این لینک تا ۱ ساعت معتبر است):</p>
                <a href="@resetUrl" class="block break-all text-indigo-600 hover:text-indigo-800 font-medium underline">
                    @resetUrl
                </a>
                <p class="text-xs text-gray-500 mt-2">در صورت عدم کارکرد لینک، آن را کپی کرده و در مرورگر قرار دهید.</p>
            </div>
        }

        <div class="text-center">
            <a asp-action="Login" class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-700 hover:to-purple-700 text-white font-semibold rounded-xl transition-all">
                <i class="bi bi-box-arrow-in-right"></i>
                بازگشت به صفحه ورود
            </a>
        </div>
    </div>
    <style>
        @@keyframes fade-in {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-fade-in { animation: fade-in 0.5s ease-out; }
    </style>
</body>
</html>
