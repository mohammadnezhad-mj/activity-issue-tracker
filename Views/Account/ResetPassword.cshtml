@{
    ViewData["Title"] = "تنظیم رمز عبور جدید";
    Layout = null;
    var token = ViewBag.Token as string ?? "";
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes" />
    <meta name="theme-color" content="#667eea" />
    <title>@ViewData["Title"]</title>
    <script src="~/lib/tailwind/tailwind.min.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" asp-append-version="true" />
</head>
<body class="min-h-screen bg-gradient-to-br from-indigo-500 via-purple-500 to-pink-500 flex items-center justify-center p-5">
    <div class="bg-white rounded-3xl shadow-2xl p-8 md:p-10 w-full max-w-md animate-fade-in">
        <div class="text-center mb-8">
            <i class="bi bi-shield-lock text-6xl text-indigo-600 mb-4"></i>
            <h2 class="text-3xl font-bold text-gray-900 mb-2">رمز عبور جدید</h2>
            <p class="text-gray-600">رمز عبور جدید خود را وارد کنید</p>
        </div>

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="mb-6 bg-red-50 border-r-4 border-red-500 text-red-800 px-4 py-3 rounded-lg flex items-center gap-3">
                <i class="bi bi-exclamation-triangle-fill text-xl"></i>
                <span>@ViewBag.ErrorMessage</span>
            </div>
        }

        <form asp-action="ResetPassword" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="token" value="@token" />

            <div class="mb-6">
                <label class="block text-sm font-semibold text-gray-700 mb-2 flex items-center gap-2">
                    <i class="bi bi-key text-indigo-600"></i>
                    رمز عبور جدید <span class="text-red-500">*</span>
                </label>
                <input type="password" name="newPassword" class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all" required placeholder="رمز عبور جدید" autocomplete="new-password" maxlength="100" />
                <p class="mt-1 text-xs text-gray-500">حداکثر ۱۰۰ کاراکتر</p>
            </div>

            <div class="mb-6">
                <label class="block text-sm font-semibold text-gray-700 mb-2 flex items-center gap-2">
                    <i class="bi bi-key-fill text-indigo-600"></i>
                    تکرار رمز عبور جدید <span class="text-red-500">*</span>
                </label>
                <input type="password" name="confirmPassword" class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all" required placeholder="تکرار رمز عبور جدید" autocomplete="new-password" maxlength="100" />
            </div>

            <button type="submit" class="w-full bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-700 hover:to-purple-700 text-white font-semibold py-3 px-6 rounded-xl transition-all duration-300 transform hover:scale-105 shadow-lg hover:shadow-xl">
                <i class="bi bi-check-circle ml-2"></i>
                ذخیره رمز عبور جدید
            </button>
        </form>

        <div class="mt-6 text-center">
            <a asp-action="Login" class="text-indigo-600 hover:text-indigo-800 font-medium flex items-center justify-center gap-2">
                <i class="bi bi-arrow-right"></i>
                بازگشت به صفحه ورود
            </a>
        </div>
    </div>
    <style>
        @@keyframes fade-in {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-fade-in { animation: fade-in 0.5s ease-out; }
    </style>
    <script>
        document.querySelector('form').addEventListener('submit', function(e) {
            var newPassword = document.querySelector('input[name="newPassword"]').value;
            var confirmPassword = document.querySelector('input[name="confirmPassword"]').value;
            if (newPassword !== confirmPassword) {
                e.preventDefault();
                alert('رمز عبور جدید و تکرار آن یکسان نیستند.');
                return false;
            }
        });
    </script>
</body>
</html>
