@{
    ViewData["Title"] = "پاسخ به سوال امنیتی";
    Layout = null;
    var requestToken = ViewBag.RequestToken as string ?? "";
    var securityQuestion = ViewBag.SecurityQuestion as string ?? "";
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes" />
    <meta name="theme-color" content="#667eea" />
    <title>@ViewData["Title"]</title>
    <script src="~/lib/tailwind/tailwind.min.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/fonts/iran-sans/fontiran.css" asp-append-version="true" />
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#667eea',
                    },
                    fontFamily: {
                        sans: ['IRANSansXFaNum', 'Tahoma', 'Arial', 'sans-serif']
                    }
                }
            }
        }
    </script>
</head>
<body class="min-h-screen bg-gradient-to-br from-indigo-500 via-purple-500 to-pink-500 flex items-center justify-center p-5">
    <div class="bg-white rounded-3xl shadow-2xl p-8 md:p-10 w-full max-w-md animate-fade-in">
        <div class="text-center mb-8">
            <i class="bi bi-shield-lock text-6xl text-indigo-600 mb-4"></i>
            <h2 class="text-3xl font-bold text-gray-900 mb-2">تأیید هویت</h2>
            <p class="text-gray-600">برای ادامه بازیابی رمز عبور، به سوال امنیتی زیر پاسخ دهید</p>
        </div>

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="mb-6 bg-red-50 border-r-4 border-red-500 text-red-800 px-4 py-3 rounded-lg flex items-center gap-3">
                <i class="bi bi-exclamation-triangle-fill text-xl"></i>
                <span>@ViewBag.ErrorMessage</span>
            </div>
        }

        <form asp-action="ForgotPasswordAnswer" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="requestToken" value="@requestToken" />

            <div class="mb-6 p-4 bg-indigo-50 rounded-xl border border-indigo-200">
                <label class="block text-sm font-semibold text-gray-700 mb-2">سوال امنیتی شما:</label>
                <p class="text-gray-800 font-medium">@securityQuestion</p>
            </div>

            <div class="mb-6">
                <label class="block text-sm font-semibold text-gray-700 mb-2 flex items-center gap-2">
                    <i class="bi bi-chat-left-text text-indigo-600"></i>
                    پاسخ شما <span class="text-red-500">*</span>
                </label>
                <input type="text" name="securityAnswer" class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all" required placeholder="پاسخ سوال امنیتی را وارد کنید" autocomplete="off" autofocus />
            </div>

            <button type="submit" class="w-full bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-700 hover:to-purple-700 text-white font-semibold py-3 px-6 rounded-xl transition-all duration-300 transform hover:scale-105 shadow-lg hover:shadow-xl">
                <i class="bi bi-check-circle ml-2"></i>
                تأیید و دریافت لینک بازیابی
            </button>
        </form>

        <div class="mt-6 text-center">
            <a asp-action="Login" class="text-indigo-600 hover:text-indigo-800 font-medium flex items-center justify-center gap-2">
                <i class="bi bi-arrow-right"></i>
                بازگشت به صفحه ورود
            </a>
        </div>
    </div>
    <style>
        body, button, input, select, textarea {
            font-family: 'IRANSansXFaNum', Tahoma, Arial, sans-serif;
        }
        @@keyframes fade-in {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-fade-in { animation: fade-in 0.5s ease-out; }
    </style>
</body>
</html>
