@{
    ViewData["Title"] = "سوال امنیتی";
    var securityQuestion = ViewBag.SecurityQuestion as string ?? "";
    var hasQuestion = ViewBag.HasQuestion as bool? ?? false;
}

<div class="min-h-screen bg-gradient-to-br from-gray-50 to-gray-100">
    <div class="bg-white shadow-sm border-b border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                <div>
                    <h1 class="text-3xl font-bold text-gray-900 flex items-center gap-3">
                        <i class="bi bi-shield-lock text-indigo-600"></i>
                        سوال امنیتی
                    </h1>
                    <p class="text-gray-600 mt-2">این سوال در بازیابی رمز عبور از شما پرسیده می‌شود تا مطمئن شویم خود شما هستید.</p>
                </div>
                <div class="flex flex-wrap gap-3">
                    <a href="@Url.Action("Dashboard", "Home")" class="inline-flex items-center gap-2 px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-800 font-medium rounded-lg transition-colors duration-200">
                        <i class="bi bi-arrow-right"></i>
                        <span>بازگشت</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="mb-6 bg-green-50 border-r-4 border-green-500 text-green-800 px-4 py-3 rounded-lg flex items-center gap-3 shadow-sm">
                <i class="bi bi-check-circle-fill text-xl"></i>
                <div class="flex-1">@TempData["SuccessMessage"]</div>
            </div>
        }

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="mb-6 bg-red-50 border-r-4 border-red-500 text-red-800 px-4 py-3 rounded-lg flex items-center gap-3 shadow-sm">
                <i class="bi bi-exclamation-triangle-fill text-xl"></i>
                <div class="flex-1">@ViewBag.ErrorMessage</div>
            </div>
        }

        @if (hasQuestion)
        {
            <div class="mb-6 p-4 bg-indigo-50 rounded-xl border border-indigo-200">
                <p class="text-sm text-gray-700 mb-1">سوال امنیتی فعلی:</p>
                <p class="text-gray-900 font-medium">@securityQuestion</p>
                <p class="text-xs text-gray-500 mt-2">می‌توانید در زیر سوال و جواب جدید وارد کنید تا جایگزین شود.</p>
            </div>
        }

        <form asp-action="SecurityQuestion" method="post" class="bg-white rounded-xl shadow-lg p-6 md:p-8">
            @Html.AntiForgeryToken()

            <div class="space-y-6">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2 flex items-center gap-2">
                        <i class="bi bi-question-circle text-indigo-600"></i>
                        سوال امنیتی <span class="text-red-500">*</span>
                    </label>
                    <textarea name="securityQuestion" rows="3" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent" placeholder="مثال: نام اولین معلم شما چه بود؟" maxlength="500" required>@securityQuestion</textarea>
                    <p class="mt-1 text-xs text-gray-500">حداکثر ۵۰۰ کاراکتر. این سوال در بازیابی رمز عبور نمایش داده می‌شود.</p>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2 flex items-center gap-2">
                        <i class="bi bi-chat-left-text text-indigo-600"></i>
                        پاسخ سوال <span class="text-red-500">*</span>
                    </label>
                    <input type="text" name="securityAnswer" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent" placeholder="پاسخ خود را وارد کنید" autocomplete="off" maxlength="200" required />
                    <p class="mt-1 text-xs text-gray-500">حداقل ۲ کاراکتر. پاسخ به صورت امن ذخیره می‌شود.</p>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2 flex items-center gap-2">
                        <i class="bi bi-chat-left-text-fill text-indigo-600"></i>
                        تکرار پاسخ <span class="text-red-500">*</span>
                    </label>
                    <input type="text" name="confirmAnswer" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent" placeholder="پاسخ را دوباره وارد کنید" autocomplete="off" maxlength="200" required />
                </div>

                <div class="flex flex-col sm:flex-row justify-end gap-3 pt-6 border-t border-gray-200">
                    <a href="@Url.Action("Dashboard", "Home")" class="px-6 py-2 bg-gray-200 hover:bg-gray-300 text-gray-800 font-medium rounded-lg transition-colors duration-200 text-center">
                        انصراف
                    </a>
                    <button type="submit" class="px-6 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-lg transition-colors duration-200 shadow-md hover:shadow-lg">
                        <i class="bi bi-check-circle ml-2"></i>ذخیره سوال امنیتی
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
    document.querySelector('form').addEventListener('submit', function(e) {
        var answer = document.querySelector('input[name="securityAnswer"]').value.trim();
        var confirmAnswer = document.querySelector('input[name="confirmAnswer"]').value.trim();
        if (answer !== confirmAnswer) {
            e.preventDefault();
            alert('پاسخ و تکرار آن یکسان نیستند.');
            return false;
        }
        if (answer.length < 2) {
            e.preventDefault();
            alert('پاسخ باید حداقل ۲ کاراکتر باشد.');
            return false;
        }
    });
</script>
