@model RayanTask.Models.ConfigurationData

@{
    ViewData["Title"] = "بازیابی رمز عبور";
    Layout = null;
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes" />
    <meta name="theme-color" content="#667eea" />
    <title>@ViewData["Title"]</title>
    <script src="~/lib/tailwind/tailwind.min.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/choices.js/choices.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/fonts/iran-sans/fontiran.css" asp-append-version="true" />
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#667eea',
                    },
                    fontFamily: {
                        sans: ['IRANSansXFaNum', 'Tahoma', 'Arial', 'sans-serif']
                    }
                }
            }
        }
    </script>
</head>
<body class="min-h-screen bg-gradient-to-br from-indigo-500 via-purple-500 to-pink-500 flex items-center justify-center p-5">
    <div class="bg-white rounded-3xl shadow-2xl p-8 md:p-10 w-full max-w-md animate-fade-in">
        <div class="text-center mb-8">
            <i class="bi bi-key-fill text-6xl text-indigo-600 mb-4"></i>
            <h2 class="text-3xl font-bold text-gray-900 mb-2">بازیابی رمز عبور</h2>
            <p class="text-gray-600">نام و نام خانوادگی خود را انتخاب کنید تا لینک بازیابی رمز عبور برای شما نمایش داده شود</p>
        </div>

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="mb-6 bg-red-50 border-r-4 border-red-500 text-red-800 px-4 py-3 rounded-lg flex items-center gap-3">
                <i class="bi bi-exclamation-triangle-fill text-xl"></i>
                <span>@ViewBag.ErrorMessage</span>
            </div>
        }

        <form asp-action="ForgotPassword" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-6">
                <label class="block text-sm font-semibold text-gray-700 mb-2 flex items-center gap-2">
                    <i class="bi bi-person text-indigo-600"></i>
                    نام و نام خانوادگی
                </label>
                <select name="fullName" class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all" required>
                    <option value="">-- انتخاب کنید --</option>
                    @foreach (var name in Model.Names)
                    {
                        <option value="@name.FirstName @name.LastName">@name.FirstName @name.LastName</option>
                    }
                </select>
            </div>

            <button type="submit" class="w-full bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-700 hover:to-purple-700 text-white font-semibold py-3 px-6 rounded-xl transition-all duration-300 transform hover:scale-105 shadow-lg hover:shadow-xl">
                <i class="bi bi-link-45deg ml-2"></i>
                دریافت لینک بازیابی
            </button>
        </form>

        <div class="mt-6 text-center">
            <a asp-action="Login" class="text-indigo-600 hover:text-indigo-800 font-medium flex items-center justify-center gap-2">
                <i class="bi bi-arrow-right"></i>
                بازگشت به صفحه ورود
            </a>
        </div>
    </div>

    <script src="~/lib/jquery/jquery-3.7.0.min.js" asp-append-version="true"></script>
    <script src="~/lib/choices.js/choices.min.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const fullNameSelect = document.querySelector('select[name="fullName"]');
            if (fullNameSelect) {
                new Choices(fullNameSelect, {
                    searchEnabled: true,
                    searchPlaceholderValue: 'جستجو...',
                    itemSelectText: '',
                    placeholder: true,
                    placeholderValue: '-- انتخاب کنید --',
                    shouldSort: false
                });
            }
        });
    </script>
    <style>
        body, button, input, select, textarea {
            font-family: 'IRANSansXFaNum', Tahoma, Arial, sans-serif;
        }
        @@keyframes fade-in {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-fade-in { animation: fade-in 0.5s ease-out; }
    </style>
</body>
</html>





