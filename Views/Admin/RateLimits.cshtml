@model List<string>

@{
    ViewData["Title"] = "مدیریت Rate Limit";
}

<div class="main-container">
    <div class="page-header">
        <div>
            <h2><i class="bi bi-shield-lock"></i>مدیریت Rate Limit</h2>
            <p class="text-muted mb-0">مشاهده و ریست کردن محدودیت‌های لاگین</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a href="@Url.Action("Dashboard", "Home")" class="btn btn-outline-primary">
                <i class="bi bi-speedometer2"></i>داشبورد
            </a>
            <a href="@Url.Action("Dashboard", "Home")" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-right"></i>بازگشت
            </a>
            @if (Model != null && Model.Any())
            {
                <form asp-action="ResetAllRateLimits" method="post" style="display: inline;" onsubmit="return confirm('آیا از ریست کردن تمام Rate limits اطمینان دارید؟');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-warning btn-sm">
                        <i class="bi bi-arrow-clockwise"></i>ریست همه
                    </button>
                </form>
            }
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center" role="alert">
            <i class="bi bi-check-circle-fill"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <div>@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="alert alert-info d-flex align-items-center">
        <i class="bi bi-info-circle-fill me-2"></i>
        <div>
            <strong>نکته:</strong> Rate limiting فقط برای صفحه لاگین اعمال می‌شود و محدودیتی برای ثبت رکوردها وجود ندارد.
            <br />
            @{
                var settings = ViewBag.RateLimitSettings as RayanTask.Models.RateLimitSettings;
                var maxRequests = settings?.MaxRequests ?? 5;
                var timeWindow = settings?.TimeWindowMinutes ?? 15;
            }
            هر IP می‌تواند حداکثر <strong>@maxRequests</strong> بار در <strong>@timeWindow</strong> دقیقه تلاش برای لاگین انجام دهد.
            <br />
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-header" style="background: var(--light); border-bottom: 1px solid var(--border);">
                <h5 class="mb-0"><i class="bi bi-list-ul"></i>IP های محدود شده</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>آدرس IP</th>
                                <th>وضعیت</th>
                                <th>عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ip in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@ip</strong>
                                    </td>
                                    <td>
                                        <span class="badge bg-danger">محدود شده</span>
                                    </td>
                                    <td>
                                        <form asp-action="ResetRateLimit" method="post" style="display: inline;" onsubmit="return confirm('آیا از ریست کردن Rate limit برای این IP اطمینان دارید؟');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="ipAddress" value="@ip" />
                                            <button type="submit" class="btn btn-sm btn-warning">
                                                <i class="bi bi-arrow-clockwise"></i>ریست
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-success text-center">
            <i class="bi bi-check-circle me-2"></i>
            در حال حاضر هیچ IP محدود شده‌ای وجود ندارد.
        </div>
    }
</div>

