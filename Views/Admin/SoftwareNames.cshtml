@model List<RayanTask.Models.SoftwareName>
@{
    ViewData["Title"] = "مدیریت نام نرم افزارها";
    var items = Model ?? new List<RayanTask.Models.SoftwareName>();
}

<div class="min-h-screen bg-gradient-to-br from-gray-50 to-gray-100">
    <!-- Header -->
    <div class="bg-white shadow-sm border-b border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                <div>
                    <h1 class="text-3xl font-bold text-gray-900 flex items-center gap-3">
                        <i class="bi bi-laptop text-indigo-600"></i>
                        مدیریت نام نرم افزارها
                    </h1>
                    <p class="text-gray-600 mt-2">ثبت و مدیریت نام نرم افزارهای شرکت</p>
                </div>
                <div class="flex flex-wrap gap-3">
                    <a href="@Url.Action("Dashboard", "Home")" class="inline-flex items-center gap-2 px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-800 font-medium rounded-lg transition-colors duration-200">
                        <i class="bi bi-speedometer2"></i>
                        <span>داشبورد</span>
                    </a>
                    <a href="@Url.Action("Dashboard", "Home")" class="inline-flex items-center gap-2 px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-800 font-medium rounded-lg transition-colors duration-200">
                        <i class="bi bi-arrow-right"></i>
                        <span>بازگشت</span>
                    </a>
                    <button type="button" onclick="openCreateModal()" class="inline-flex items-center gap-2 px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-lg transition-colors duration-200 shadow-md hover:shadow-lg">
                        <i class="bi bi-plus-circle"></i>
                        <span>نام نرم افزار جدید</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Alerts -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="mb-6 bg-green-50 border-r-4 border-green-500 text-green-800 px-4 py-3 rounded-lg flex items-center gap-3 shadow-sm">
                <i class="bi bi-check-circle-fill text-xl"></i>
                <div class="flex-1">@TempData["SuccessMessage"]</div>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="mb-6 bg-red-50 border-r-4 border-red-500 text-red-800 px-4 py-3 rounded-lg flex items-center gap-3 shadow-sm">
                <i class="bi bi-exclamation-triangle-fill text-xl"></i>
                <div class="flex-1">@TempData["ErrorMessage"]</div>
            </div>
        }

        @if (items.Any())
        {
            <div class="bg-white rounded-xl shadow-lg overflow-hidden">
                <div class="bg-gradient-to-r from-indigo-600 to-indigo-700 px-6 py-4">
                    <h2 class="text-xl font-bold text-white flex items-center gap-2">
                        <i class="bi bi-list-check"></i>
                        لیست نام نرم افزارها (@items.Count مورد)
                    </h2>
                </div>
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-6 py-3 text-right text-xs font-medium text-gray-700 uppercase tracking-wider">نام نرم افزار</th>
                                <th class="px-6 py-3 text-right text-xs font-medium text-gray-700 uppercase tracking-wider">وضعیت</th>
                                <th class="px-6 py-3 text-right text-xs font-medium text-gray-700 uppercase tracking-wider">عملیات</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                            @foreach (var softwareName in items)
                            {
                                <tr class="hover:bg-gray-50 transition-colors duration-150">
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <span class="text-sm font-medium text-gray-900">@softwareName.Value</span>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        @if (softwareName.IsActive)
                                        {
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">فعال</span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">غیرفعال</span>
                                        }
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                        <div class="flex items-center gap-2">
                                            <button type="button" onclick="openEditModal(@softwareName.Id, '@softwareName.Value')" class="inline-flex items-center gap-1 px-3 py-1.5 bg-amber-500 hover:bg-amber-600 text-white text-sm font-medium rounded-lg transition-colors duration-200">
                                                <i class="bi bi-pencil"></i>
                                                <span>ویرایش</span>
                                            </button>
                                            <form asp-action="ToggleSoftwareNameStatus" method="post" class="inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@softwareName.Id" />
                                                <button type="submit" class="inline-flex items-center gap-1 px-3 py-1.5 @(softwareName.IsActive ? "bg-gray-500 hover:bg-gray-600" : "bg-green-600 hover:bg-green-700") text-white text-sm font-medium rounded-lg transition-colors duration-200">
                                                    <i class="bi bi-@(softwareName.IsActive ? "eye-slash" : "eye")"></i>
                                                    <span>@(softwareName.IsActive ? "غیرفعال" : "فعال")</span>
                                                </button>
                                            </form>
                                            <form asp-action="DeleteSoftwareName" method="post" class="inline" onsubmit="return confirm('آیا از حذف این نام نرم افزار اطمینان دارید؟');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@softwareName.Id" />
                                                <button type="submit" class="inline-flex items-center gap-1 px-3 py-1.5 bg-red-600 hover:bg-red-700 text-white text-sm font-medium rounded-lg transition-colors duration-200">
                                                    <i class="bi bi-trash"></i>
                                                    <span>حذف</span>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            <div class="bg-white rounded-xl shadow-lg p-8">
                <div class="text-center">
                    <i class="bi bi-info-circle text-6xl text-gray-400 mb-4"></i>
                    <p class="text-gray-600 text-lg">هیچ نام نرم افزاری ثبت نشده است.</p>
                </div>
            </div>
        }
    </div>
</div>

<!-- Create Modal -->
<div id="createModal" class="hidden fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-50" style="direction: rtl;">
    <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-xl bg-white">
        <div class="flex justify-between items-center mb-4">
            <h3 class="text-lg font-bold text-gray-900">ثبت نام نرم افزار جدید</h3>
            <button onclick="closeCreateModal()" class="text-gray-400 hover:text-gray-600">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <form asp-action="CreateSoftwareName" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-2">نام نرم افزار <span class="text-red-500">*</span></label>
                <input type="text" name="value" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent" required maxlength="200" />
            </div>
            <div class="flex gap-3">
                <button type="button" onclick="closeCreateModal()" class="flex-1 px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-800 font-medium rounded-lg transition-colors duration-200">
                    انصراف
                </button>
                <button type="submit" class="flex-1 px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-lg transition-colors duration-200">
                    ذخیره
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Edit Modals -->
@foreach (var softwareName in items)
{
    <div id="editModal@(softwareName.Id)" class="hidden fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-50" style="direction: rtl;">
        <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-xl bg-white">
            <div class="flex justify-between items-center mb-4">
                <h3 class="text-lg font-bold text-gray-900">ویرایش نام نرم افزار</h3>
                <button onclick="closeEditModal(@softwareName.Id)" class="text-gray-400 hover:text-gray-600">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <form asp-action="EditSoftwareName" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@softwareName.Id" />
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-2">نام نرم افزار</label>
                    <input type="text" name="value" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent" value="@softwareName.Value" required maxlength="200" />
                </div>
                <div class="flex gap-3">
                    <button type="button" onclick="closeEditModal(@softwareName.Id)" class="flex-1 px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-800 font-medium rounded-lg transition-colors duration-200">
                        انصراف
                    </button>
                    <button type="submit" class="flex-1 px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-lg transition-colors duration-200">
                        ذخیره
                    </button>
                </div>
            </form>
        </div>
    </div>
}

<script>
function openCreateModal() {
    document.getElementById('createModal').classList.remove('hidden');
}

function closeCreateModal() {
    document.getElementById('createModal').classList.add('hidden');
}

function openEditModal(id, value) {
    document.getElementById('editModal' + id).classList.remove('hidden');
}

function closeEditModal(id) {
    document.getElementById('editModal' + id).classList.add('hidden');
}

window.onclick = function(event) {
    if (event.target.classList.contains('bg-opacity-50')) {
        event.target.classList.add('hidden');
    }
}
</script>
