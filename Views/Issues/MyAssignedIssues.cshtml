@model RayanTask.Controllers.MyAssignedIssuesViewModel

@{
    ViewData["Title"] = "مشکلات انتساب داده شده به من";
}

<div class="min-h-screen bg-gradient-to-br from-gray-50 to-gray-100">
    <!-- Header -->
    <div class="bg-white shadow-sm border-b border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                <div>
                    <h1 class="text-3xl font-bold text-gray-900 flex items-center gap-3">
                        <i class="bi bi-person-check text-indigo-600"></i>
                        مشکلات انتساب داده شده به من
                    </h1>
                    <p class="text-gray-600 mt-2">مشکلاتی که به شما انتساب داده شده است</p>
                </div>
                <div class="flex flex-wrap gap-3">
                    <a href="@Url.Action("Dashboard", "Home")" class="inline-flex items-center gap-2 px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-800 font-medium rounded-lg transition-colors duration-200">
                        <i class="bi bi-speedometer2"></i>
                        <span>داشبورد</span>
                    </a>
                    <a href="@Url.Action("Index", "Issues")" class="inline-flex items-center gap-2 px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-800 font-medium rounded-lg transition-colors duration-200">
                        <i class="bi bi-arrow-right"></i>
                        <span>بازگشت به لیست</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Alerts -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="mb-6 bg-green-50 border-r-4 border-green-500 text-green-800 px-4 py-3 rounded-lg flex items-center gap-3 shadow-sm">
                <i class="bi bi-check-circle-fill text-xl"></i>
                <div class="flex-1">@TempData["SuccessMessage"]</div>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="mb-6 bg-red-50 border-r-4 border-red-500 text-red-800 px-4 py-3 rounded-lg flex items-center gap-3 shadow-sm">
                <i class="bi bi-exclamation-triangle-fill text-xl"></i>
                <div class="flex-1">@TempData["ErrorMessage"]</div>
            </div>
        }

        @if (Model.Issues.Any())
        {
            <div class="mb-4">
                <h3 class="text-lg font-semibold text-gray-700 flex items-center gap-2">
                    <i class="bi bi-list-ul text-indigo-600"></i>
                    تعداد: @Model.Issues.Count مورد
                </h3>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                @foreach (var issue in Model.Issues)
                {
                    <div class="bg-white rounded-xl shadow-md hover:shadow-xl transition-shadow duration-200 overflow-hidden">
                        <div class="bg-gradient-to-r from-gray-50 to-gray-100 px-6 py-4 border-b border-gray-200">
                            <div class="flex justify-between items-start mb-2">
                                <div class="flex-1">
                                    <h3 class="text-lg font-bold text-gray-900 mb-1">#@issue.Id</h3>
                                    <h4 class="text-base font-semibold text-gray-800">@issue.Title</h4>
                                </div>
                                @{
                                    var statusBadgeClass = issue.Status switch
                                    {
                                        "ثبت شده" => "bg-gray-100 text-gray-800",
                                        "در حال بررسی" => "bg-yellow-100 text-yellow-800",
                                        "در حال انجام" => "bg-blue-100 text-blue-800",
                                        "تکمیل شده" => "bg-green-100 text-green-800",
                                        "لغو شده" => "bg-red-100 text-red-800",
                                        _ => "bg-gray-100 text-gray-800"
                                    };
                                }
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium @statusBadgeClass">
                                    @issue.Status
                                </span>
                            </div>
                            <div class="mt-2">
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-cyan-100 text-cyan-800">
                                    @issue.IssueType
                                </span>
                            </div>
                        </div>
                        <div class="p-6">
                            <div class="space-y-3 mb-4">
                                <div>
                                    <small class="text-gray-500 block mb-1 flex items-center gap-1">
                                        <i class="bi bi-laptop"></i> نرم افزار:
                                    </small>
                                    <strong class="text-gray-900">@issue.SoftwareName</strong>
                                </div>
                                <div>
                                    <small class="text-gray-500 block mb-1 flex items-center gap-1">
                                        <i class="bi bi-person"></i> ثبت کننده:
                                    </small>
                                    <strong class="text-gray-900">@issue.ReporterFirstName @issue.ReporterLastName</strong>
                                </div>
                                @{
                                    var prevAssignee = Model.PreviousAssignee.TryGetValue(issue.Id, out var pa) ? pa : null;
                                }
                                @if (!string.IsNullOrWhiteSpace(prevAssignee))
                                {
                                    <div>
                                        <small class="text-gray-500 block mb-1 flex items-center gap-1">
                                            <i class="bi bi-person-dash"></i> مسئول قبلی:
                                        </small>
                                        <strong class="text-gray-900">@prevAssignee</strong>
                                    </div>
                                }
                                <div>
                                    <small class="text-gray-500 block mb-1 flex items-center gap-1">
                                        <i class="bi bi-calendar"></i> زمان ثبت:
                                    </small>
                                    <strong class="text-gray-900">@issue.CreatedAt.ToString("yyyy/MM/dd HH:mm")</strong>
                                </div>
                                @if (issue.DurationMinutes.HasValue)
                                {
                                    <div>
                                        <small class="text-gray-500 block mb-1 flex items-center gap-1">
                                            <i class="bi bi-clock"></i> مدت زمان:
                                        </small>
                                        <strong class="text-gray-900">@issue.GetDurationDisplay()</strong>
                                    </div>
                                }
                            </div>
                            
                            <div class="mb-4">
                                <small class="text-gray-500 block mb-2 flex items-center gap-1">
                                    <i class="bi bi-file-text"></i> شرح:
                                </small>
                                <p class="text-sm text-gray-700 line-clamp-3">
                                    @(issue.Description.Length > 150 ? issue.Description.Substring(0, 150) + "..." : issue.Description)
                                </p>
                            </div>

                            <a href="@Url.Action("Details", "Issues", new { id = issue.Id })" class="w-full inline-flex items-center justify-center gap-2 px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-lg transition-colors duration-200 shadow-md hover:shadow-lg">
                                <i class="bi bi-eye"></i>
                                <span>مشاهده جزئیات</span>
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="bg-white rounded-xl shadow-lg p-12 text-center">
                <i class="bi bi-inbox text-6xl text-gray-400 mb-4"></i>
                <h3 class="text-xl font-semibold text-gray-700 mb-2">هیچ مشکلی به شما انتساب داده نشده است</h3>
                <p class="text-gray-500">وقتی مشکلی به شما انتساب داده شود، در اینجا نمایش داده می‌شود.</p>
            </div>
        }
    </div>
</div>
