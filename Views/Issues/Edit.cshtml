@model RayanTask.Controllers.EditIssueViewModel

@{
    ViewData["Title"] = $"ویرایش مشکل #{Model.Issue.Id}";
    var hasGitDetails = !string.IsNullOrWhiteSpace(Model.Issue.BranchName)
        || !string.IsNullOrWhiteSpace(Model.Issue.RepositoryUrl)
        || !string.IsNullOrWhiteSpace(Model.Issue.CommitUrl)
        || !string.IsNullOrWhiteSpace(Model.Issue.WorkItemType)
        || !string.IsNullOrWhiteSpace(Model.Issue.GitStatus);
    var fullEditDisabled = !Model.CanEditFullIssue ? "disabled" : null;
}

<div class="min-h-screen bg-gray-50" dir="rtl">
    <div class="bg-white border-b border-gray-200">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-5">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                <div>
                    <h1 class="text-2xl md:text-3xl font-bold text-gray-900 flex items-center gap-3">
                        <i class="bi bi-pencil text-indigo-600"></i>
                        ویرایش مشکل #@Model.Issue.Id
                    </h1>
                    <p class="mt-2 text-sm text-gray-600">@Model.Issue.Title</p>
                </div>
                <a href="@Url.Action("Details", "Issues", new { id = Model.Issue.Id })" class="inline-flex items-center gap-2 px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-800 font-medium rounded-lg transition-colors duration-200">
                    <i class="bi bi-arrow-right"></i>
                    <span>بازگشت به جزئیات</span>
                </a>
            </div>
        </div>
    </div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="mb-6 bg-red-50 border-r-4 border-red-500 text-red-800 px-4 py-3 rounded-lg flex items-center gap-3 shadow-sm">
                <i class="bi bi-exclamation-triangle-fill text-xl"></i>
                <div class="flex-1">@TempData["ErrorMessage"]</div>
            </div>
        }

        <form asp-action="Edit" method="post" class="bg-white border border-gray-200 rounded-lg shadow-sm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Issue.Id" />
            <input type="hidden" name="returnUrl" value="@Context.Request.Query["returnUrl"]" />
            @if (!Model.CanEditFullIssue && Model.CanEditGitDetails)
            {
                <div class="mx-5 md:mx-6 mt-5 bg-amber-50 border-r-4 border-amber-500 text-amber-800 px-4 py-3 rounded-lg text-sm">
                    شما فقط امکان ویرایش بخش «جزئیات فنی و گیت» را دارید.
                </div>
            }

            <div class="p-5 md:p-6 space-y-8">
                <section>
                    <div class="flex items-center gap-2 mb-4">
                        <span class="flex h-8 w-8 items-center justify-center rounded-full bg-indigo-50 text-indigo-700 font-bold">1</span>
                        <h2 class="text-lg font-semibold text-gray-900">اصل درخواست</h2>
                    </div>

                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
                        <div class="lg:col-span-2">
                            <label class="block text-sm font-medium text-gray-700 mb-2">عنوان <span class="text-red-500">*</span></label>
                            <input type="text" asp-for="Issue.Title" disabled="@fullEditDisabled" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent disabled:bg-gray-100 disabled:text-gray-500" required maxlength="200" />
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">مشتری</label>
                            <input type="text" asp-for="Issue.CustomerName" disabled="@fullEditDisabled" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent disabled:bg-gray-100 disabled:text-gray-500" maxlength="200" />
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">نرم‌افزار <span class="text-red-500">*</span></label>
                            <select asp-for="Issue.SoftwareName" disabled="@fullEditDisabled" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent disabled:bg-gray-100 disabled:text-gray-500" required>
                                <option value="">انتخاب کنید</option>
                                @foreach (var software in Model.SoftwareNames)
                                {
                                    <option value="@software" selected="@(Model.Issue.SoftwareName == software)">@software</option>
                                }
                            </select>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">نوع درخواست <span class="text-red-500">*</span></label>
                            <select asp-for="Issue.IssueType" disabled="@fullEditDisabled" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent disabled:bg-gray-100 disabled:text-gray-500" required>
                                <option value="">انتخاب کنید</option>
                                @foreach (var issueType in Model.IssueTypes)
                                {
                                    <option value="@issueType" selected="@(Model.Issue.IssueType == issueType)">@issueType</option>
                                }
                            </select>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">محیط</label>
                            <select asp-for="Issue.Environment" disabled="@fullEditDisabled" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent disabled:bg-gray-100 disabled:text-gray-500">
                                <option value="">نامشخص</option>
                                @foreach (var environment in new[] { "Production", "Test", "Development" })
                                {
                                    <option value="@environment" selected="@(Model.Issue.Environment == environment ? "selected" : null)">
                                        @(environment == "Production" ? "عملیاتی" : environment == "Test" ? "تست" : "توسعه")
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="lg:col-span-3">
                            <label class="block text-sm font-medium text-gray-700 mb-2">شرح کامل <span class="text-red-500">*</span></label>
                            <textarea asp-for="Issue.Description" disabled="@fullEditDisabled" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent disabled:bg-gray-100 disabled:text-gray-500" rows="5" required maxlength="2000"></textarea>
                        </div>
                    </div>
                </section>

                <section class="border-t border-gray-200 pt-6">
                    <div class="flex items-center gap-2 mb-4">
                        <span class="flex h-8 w-8 items-center justify-center rounded-full bg-indigo-50 text-indigo-700 font-bold">2</span>
                        <h2 class="text-lg font-semibold text-gray-900">وضعیت و پیگیری</h2>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">وضعیت <span class="text-red-500">*</span></label>
                            <select asp-for="Issue.Status" disabled="@fullEditDisabled" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent disabled:bg-gray-100 disabled:text-gray-500" required>
                                @foreach (var status in Model.StatusOptions)
                                {
                                    <option value="@status" selected="@(Model.Issue.Status == status)">@status</option>
                                }
                            </select>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">کانال گزارش</label>
                            <select asp-for="Issue.ReportedChannel" id="reportedChannelSelect" disabled="@fullEditDisabled" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent disabled:bg-gray-100 disabled:text-gray-500">
                                <option value="">انتخاب نشده</option>
                                @foreach (var channel in new[] { "Phone", "Telegram", "Email", "In Person", "System" })
                                {
                                    <option value="@channel" selected="@(Model.Issue.ReportedChannel == channel ? "selected" : null)">
                                        @(channel == "Phone" ? "تلفن" : channel == "Telegram" ? "تلگرام" : channel == "Email" ? "ایمیل" : channel == "In Person" ? "حضوری" : "سیستم")
                                    </option>
                                }
                            </select>
                        </div>

                        <div id="reportedChannelUrlGroup" class="hidden md:col-span-2">
                            <label class="block text-sm font-medium text-gray-700 mb-2">لینک کانال/پیام</label>
                            <input type="url" asp-for="Issue.ReportedChannelUrl" id="reportedChannelUrlInput" disabled="@fullEditDisabled" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent disabled:bg-gray-100 disabled:text-gray-500" maxlength="1000" placeholder="https://..." />
                        </div>
                    </div>
                </section>

                <section class="border-t border-gray-200 pt-6">
                    <div class="flex items-center gap-2 mb-4">
                        <span class="flex h-8 w-8 items-center justify-center rounded-full bg-indigo-50 text-indigo-700 font-bold">3</span>
                        <h2 class="text-lg font-semibold text-gray-900">اولویت و مالکیت</h2>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">اولویت</label>
                            <select asp-for="Issue.Priority" disabled="@fullEditDisabled" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent disabled:bg-gray-100 disabled:text-gray-500">
                                <option value="">نامشخص</option>
                                @foreach (var priority in new[] { "Low", "Medium", "High", "Urgent" })
                                {
                                    <option value="@priority" selected="@(Model.Issue.Priority == priority ? "selected" : null)">
                                        @(priority == "Low" ? "کم" : priority == "Medium" ? "متوسط" : priority == "High" ? "زیاد" : "فوری")
                                    </option>
                                }
                            </select>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">شدت اثر</label>
                            <select asp-for="Issue.Severity" disabled="@fullEditDisabled" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent disabled:bg-gray-100 disabled:text-gray-500">
                                <option value="">نامشخص</option>
                                @foreach (var severity in new[] { "Minor", "Major", "Critical" })
                                {
                                    <option value="@severity" selected="@(Model.Issue.Severity == severity ? "selected" : null)">
                                        @(severity == "Minor" ? "جزئی" : severity == "Major" ? "مهم" : "بحرانی")
                                    </option>
                                }
                            </select>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">موعد پیگیری</label>
                            <input type="date" asp-for="Issue.DueDate" disabled="@fullEditDisabled" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent disabled:bg-gray-100 disabled:text-gray-500" />
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">مسئول</label>
                            <select disabled="@fullEditDisabled" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent disabled:bg-gray-100 disabled:text-gray-500" id="assignedToSelect">
                                <option value="">بدون مسئول</option>
                                @foreach (var user in Model.ActiveUsers)
                                {
                                    var isSelected = Model.Issue.AssignedToFirstName == user.FirstName && Model.Issue.AssignedToLastName == user.LastName;
                                    <option value="@user.FirstName" data-lastname="@user.LastName" selected="@isSelected">@user.FirstName @user.LastName</option>
                                }
                            </select>
                            <input type="hidden" asp-for="Issue.AssignedToFirstName" id="assignedToFirstName" value="@Model.Issue.AssignedToFirstName" />
                            <input type="hidden" asp-for="Issue.AssignedToLastName" id="assignedToLastName" value="@Model.Issue.AssignedToLastName" />
                        </div>
                    </div>
                </section>

                <section class="border-t border-gray-200 pt-6">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                        <label class="flex items-start gap-3 rounded-lg border border-gray-200 bg-gray-50 p-4 cursor-pointer">
                            <input type="checkbox" asp-for="StartWork" disabled="@fullEditDisabled" class="mt-1 w-4 h-4 text-indigo-600 border-gray-300 rounded focus:ring-indigo-500" />
                            <span>
                                <span class="block text-sm font-medium text-gray-900">شروع کار</span>
                                @if (Model.Issue.StartedAt.HasValue)
                                {
                                    <span class="block mt-1 text-xs text-gray-500">زمان شروع فعلی: @Model.Issue.StartedAt.Value.ToString("yyyy/MM/dd HH:mm")</span>
                                }
                            </span>
                        </label>

                        <label class="flex items-start gap-3 rounded-lg border border-gray-200 bg-gray-50 p-4 cursor-pointer">
                            <input type="checkbox" asp-for="CompleteWork" disabled="@fullEditDisabled" class="mt-1 w-4 h-4 text-indigo-600 border-gray-300 rounded focus:ring-indigo-500" />
                            <span>
                                <span class="block text-sm font-medium text-gray-900">تکمیل کار</span>
                                @if (Model.Issue.CompletedAt.HasValue)
                                {
                                    <span class="block mt-1 text-xs text-gray-500">زمان پایان فعلی: @Model.Issue.CompletedAt.Value.ToString("yyyy/MM/dd HH:mm")</span>
                                }
                            </span>
                        </label>
                    </div>
                </section>

                <details class="border-t border-gray-200 pt-6" id="gitDetails" @(hasGitDetails ? "open" : "")>
                    <summary class="flex cursor-pointer list-none items-center justify-between gap-4">
                        <span class="flex items-center gap-2">
                            <span class="flex h-8 w-8 items-center justify-center rounded-full bg-gray-100 text-gray-700">
                                <i class="bi bi-git"></i>
                            </span>
                            <span class="text-lg font-semibold text-gray-900">جزئیات فنی و گیت</span>
                        </span>
                        <i class="bi bi-chevron-down text-gray-500"></i>
                    </summary>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mt-5">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Branch</label>
                            <input type="text" asp-for="Issue.BranchName" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent" maxlength="200" placeholder="feature/login" />
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">نوع آیتم</label>
                            <select asp-for="Issue.WorkItemType" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent">
                                <option value="">انتخاب نشده</option>
                                @foreach (var workItemType in new[] { "Issue", "Pull Request", "Merge Request", "Commit", "Pipeline", "Release", "Other" })
                                {
                                    <option value="@workItemType" selected="@(Model.Issue.WorkItemType == workItemType ? "selected" : null)">@workItemType</option>
                                }
                            </select>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">وضعیت گیت</label>
                            <select asp-for="Issue.GitStatus" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent">
                                <option value="">انتخاب نشده</option>
                                @foreach (var gitStatus in new[] { "Opened", "In Progress", "Reviewed", "Merged", "Closed", "Failed", "Deployed" })
                                {
                                    <option value="@gitStatus" selected="@(Model.Issue.GitStatus == gitStatus ? "selected" : null)">@gitStatus</option>
                                }
                            </select>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Repository URL</label>
                            <input type="url" asp-for="Issue.RepositoryUrl" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent" maxlength="1000" placeholder="https://github.com/org/repo" />
                        </div>

                        <div class="md:col-span-2">
                            <label class="block text-sm font-medium text-gray-700 mb-2">Commit / Merge URL</label>
                            <input type="url" asp-for="Issue.CommitUrl" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent" maxlength="1000" placeholder="https://github.com/org/repo/commit/..." />
                        </div>
                    </div>
                </details>
            </div>

            <div class="flex flex-col sm:flex-row justify-end gap-3 px-5 md:px-6 py-4 bg-gray-50 border-t border-gray-200 rounded-b-lg">
                <a href="@Url.Action("Details", "Issues", new { id = Model.Issue.Id })" class="px-6 py-2.5 bg-white hover:bg-gray-100 text-gray-800 font-medium rounded-lg border border-gray-300 transition-colors duration-200 text-center">
                    <i class="bi bi-x-circle ml-2"></i>انصراف
                </a>
                <button type="submit" class="px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-lg transition-colors duration-200 shadow-sm">
                    <i class="bi bi-check-circle ml-2"></i>@(Model.CanEditFullIssue ? "ذخیره تغییرات" : "ذخیره جزئیات گیت")
                </button>
                @if (Model.Issue.Id > 0 && Model.CanEditFullIssue)
                {
                    <button type="button" onclick="confirmDelete()" class="px-6 py-2.5 bg-red-600 hover:bg-red-700 text-white font-medium rounded-lg transition-colors duration-200">
                        <i class="bi bi-trash ml-2"></i>حذف
                    </button>
                }
            </div>
        </form>
    </div>
</div>

<script>
    const assignedToSelect = document.getElementById('assignedToSelect');
    const reportedChannelSelect = document.getElementById('reportedChannelSelect');
    const reportedChannelUrlGroup = document.getElementById('reportedChannelUrlGroup');
    const reportedChannelUrlInput = document.getElementById('reportedChannelUrlInput');

    assignedToSelect?.addEventListener('change', function () {
        const selectedOption = this.options[this.selectedIndex];
        document.getElementById('assignedToFirstName').value = selectedOption.value || '';
        document.getElementById('assignedToLastName').value = selectedOption.getAttribute('data-lastname') || '';
    });

    function syncReportedChannelUrl() {
        const hasChannel = Boolean(reportedChannelSelect?.value);
        reportedChannelUrlGroup?.classList.toggle('hidden', !hasChannel);
        if (!hasChannel && reportedChannelUrlInput) {
            reportedChannelUrlInput.value = '';
        }
    }

    reportedChannelSelect?.addEventListener('change', syncReportedChannelUrl);
    syncReportedChannelUrl();

    function confirmDelete() {
        if (confirm('آیا از حذف این مشکل اطمینان دارید؟')) {
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '@Url.Action("Delete", "Issues", new { id = Model.Issue.Id })';

            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            const tokenInput = document.createElement('input');
            tokenInput.type = 'hidden';
            tokenInput.name = '__RequestVerificationToken';
            tokenInput.value = token;
            form.appendChild(tokenInput);

            document.body.appendChild(form);
            form.submit();
        }
    }
</script>
