@model RayanTask.Controllers.IssueDetailsViewModel

@{
    ViewData["Title"] = $"جزئیات مشکل #{Model.Issue.Id}";
    var hasGitDetails = !string.IsNullOrWhiteSpace(Model.Issue.BranchName)
        || !string.IsNullOrWhiteSpace(Model.Issue.RepositoryUrl)
        || !string.IsNullOrWhiteSpace(Model.Issue.CommitUrl)
        || !string.IsNullOrWhiteSpace(Model.Issue.WorkItemType)
        || !string.IsNullOrWhiteSpace(Model.Issue.GitStatus);
    var returnUrl = Context.Request.Query["returnUrl"].ToString();
    var backUrl = !string.IsNullOrWhiteSpace(returnUrl) && returnUrl.StartsWith("/") ? returnUrl : Url.Action("Index", "Issues");
    var currentDetailsUrl = Context.Request.Path + Context.Request.QueryString;
    var showSidePanel = true;
    var detailsGridClass = showSidePanel ? "grid grid-cols-1 lg:grid-cols-3 gap-6" : "grid grid-cols-1 gap-6";
}

@functions {
    private static string EmptyText(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private static string FormatDate(DateTime? value) => value.HasValue ? value.Value.ToString("yyyy/MM/dd HH:mm") : "-";

    private static string PriorityClass(string? priority) => priority switch
    {
        "Urgent" => "bg-rose-50 text-rose-800 border-rose-200",
        "High" => "bg-orange-50 text-orange-800 border-orange-200",
        "Medium" => "bg-blue-50 text-blue-800 border-blue-200",
        "Low" => "bg-slate-50 text-slate-700 border-slate-200",
        _ => "bg-gray-50 text-gray-600 border-gray-200"
    };

    private static string SeverityClass(string? severity) => severity switch
    {
        "Critical" => "bg-red-50 text-red-800 border-red-200",
        "Major" => "bg-violet-50 text-violet-800 border-violet-200",
        "Minor" => "bg-teal-50 text-teal-800 border-teal-200",
        _ => "bg-gray-50 text-gray-600 border-gray-200"
    };

    private static (string label, string cssClass) LogActionBadge(string action) => action switch
    {
        "Create" => ("ایجاد", "bg-green-100 text-green-800"),
        "Update" => ("ویرایش", "bg-yellow-100 text-yellow-800"),
        "Delete" => ("حذف", "bg-red-100 text-red-800"),
        "AddComment" => ("افزودن کامنت", "bg-indigo-100 text-indigo-800"),
        "QuickAddComment" => ("افزودن کامنت", "bg-indigo-100 text-indigo-800"),
        "UpdateStatus" => ("به‌روزرسانی وضعیت", "bg-blue-100 text-blue-800"),
        "QuickUpdateStatus" => ("به‌روزرسانی وضعیت", "bg-blue-100 text-blue-800"),
        "QuickAssign" => ("تغییر مسئول", "bg-blue-100 text-blue-800"),
        "QuickStart" => ("شروع کار", "bg-purple-100 text-purple-800"),
        "QuickComplete" => ("تکمیل", "bg-green-100 text-green-800"),
        _ => (action, "bg-gray-100 text-gray-800")
    };
}

<div class="min-h-screen bg-gray-50" dir="rtl">
    <div class="bg-white border-b border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5">
            <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center gap-4">
                <div>
                    <h1 class="text-2xl md:text-3xl font-bold text-gray-900 flex items-center gap-3">
                        <i class="bi bi-info-circle text-indigo-600"></i>
                        جزئیات مشکل #@Model.Issue.Id
                    </h1>
                    <p class="mt-2 text-sm text-gray-600 max-w-3xl">@Model.Issue.Title</p>
                </div>
                <div class="flex flex-wrap gap-3">
                    <a href="@backUrl" class="inline-flex items-center gap-2 px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-800 font-medium rounded-lg transition-colors duration-200">
                        <i class="bi bi-arrow-right"></i>
                        <span>بازگشت به لیست</span>
                    </a>
                    @if (Model.CanEditIssues || Model.IsAdmin || Model.IsAssigned)
                    {
                        <a href="@Url.Action("Edit", "Issues", new { id = Model.Issue.Id, returnUrl })" class="inline-flex items-center gap-2 px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-lg transition-colors duration-200 shadow-sm">
                            <i class="bi bi-pencil"></i>
                            <span>@(Model.CanEditIssues || Model.IsAdmin ? "ویرایش" : "ویرایش Git")</span>
                        </a>
                    }
                    @if (Model.CanDeleteIssues)
                    {
                        <form asp-action="Delete" method="post" class="inline-flex" onsubmit="return confirm('آیا از حذف این مشکل اطمینان دارید؟');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Issue.Id" />
                            <input type="hidden" name="returnUrl" value="@backUrl" />
                            <button type="submit" class="inline-flex items-center gap-2 px-4 py-2 bg-red-600 hover:bg-red-700 text-white font-medium rounded-lg transition-colors duration-200 shadow-sm">
                                <i class="bi bi-trash"></i>
                                <span>حذف</span>
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="mb-6 bg-green-50 border-r-4 border-green-500 text-green-800 px-4 py-3 rounded-lg flex items-center gap-3 shadow-sm">
                <i class="bi bi-check-circle-fill text-xl"></i>
                <div class="flex-1">@TempData["SuccessMessage"]</div>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="mb-6 bg-red-50 border-r-4 border-red-500 text-red-800 px-4 py-3 rounded-lg flex items-center gap-3 shadow-sm">
                <i class="bi bi-exclamation-triangle-fill text-xl"></i>
                <div class="flex-1">@TempData["ErrorMessage"]</div>
            </div>
        }

        <div class="@detailsGridClass">
            <div class="@(showSidePanel ? "lg:col-span-2" : "") space-y-6">
                <section class="bg-white border border-gray-200 rounded-lg shadow-sm p-5 md:p-6">
                    <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4 mb-5">
                        <div>
                            <h2 class="text-xl font-bold text-gray-900">@Model.Issue.Title</h2>
                            <div class="mt-3 flex flex-wrap items-center gap-2 text-sm text-gray-600">
                                <span class="inline-flex items-center gap-1"><i class="bi bi-laptop"></i>@Model.Issue.SoftwareName</span>
                                <span class="inline-flex items-center gap-1"><i class="bi bi-tag"></i>@Model.Issue.IssueType</span>
                                <span class="inline-flex items-center gap-1"><i class="bi bi-person"></i>@EmptyText(Model.Issue.CustomerName)</span>
                            </div>
                        </div>
                        <span class="inline-flex items-center px-3 py-1.5 rounded-full text-sm font-medium border bg-slate-50 text-slate-800 border-slate-200 whitespace-nowrap">
                            @Model.Issue.Status
                        </span>
                    </div>

                    <div class="rounded-lg bg-gray-50 border border-gray-200 p-4">
                        <h3 class="text-sm font-semibold text-gray-700 mb-2">شرح کامل</h3>
                        <p class="text-gray-800 leading-8 whitespace-pre-wrap">@Model.Issue.Description</p>
                    </div>
                </section>

                <section class="bg-white border border-gray-200 rounded-lg shadow-sm p-5 md:p-6">
                    <h2 class="text-lg font-semibold text-gray-900 mb-4 flex items-center gap-2">
                        <i class="bi bi-clipboard2-pulse text-indigo-600"></i>
                        پیگیری و اولویت
                    </h2>

                    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
                        <div class="rounded-lg border border-gray-200 p-4">
                            <div class="text-xs text-gray-500 mb-2">اولویت</div>
                            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium border @PriorityClass(Model.Issue.Priority)">
                                @EmptyText(Model.Issue.Priority)
                            </span>
                        </div>
                        <div class="rounded-lg border border-gray-200 p-4">
                            <div class="text-xs text-gray-500 mb-2">شدت اثر</div>
                            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium border @SeverityClass(Model.Issue.Severity)">
                                @EmptyText(Model.Issue.Severity)
                            </span>
                        </div>
                        <div class="rounded-lg border border-gray-200 p-4">
                            <div class="text-xs text-gray-500 mb-2">موعد پیگیری</div>
                            <div class="text-sm font-medium text-gray-900 whitespace-nowrap">@(Model.Issue.DueDate.HasValue ? Model.Issue.DueDate.Value.ToString("yyyy/MM/dd") : "-")</div>
                        </div>
                        <div class="rounded-lg border border-gray-200 p-4">
                            <div class="text-xs text-gray-500 mb-2">محیط</div>
                            <div class="text-sm font-medium text-gray-900">@EmptyText(Model.Issue.Environment)</div>
                        </div>
                        <div class="rounded-lg border border-gray-200 p-4">
                            <div class="text-xs text-gray-500 mb-2">کانال گزارش</div>
                            <div class="text-sm font-medium text-gray-900">@EmptyText(Model.Issue.ReportedChannel)</div>
                        </div>
                        <div class="rounded-lg border border-gray-200 p-4">
                            <div class="text-xs text-gray-500 mb-2">لینک کانال</div>
                            @if (!string.IsNullOrWhiteSpace(Model.Issue.ReportedChannelUrl))
                            {
                                <a href="@Model.Issue.ReportedChannelUrl" target="_blank" rel="noopener noreferrer" class="text-sm font-medium text-indigo-700 hover:text-indigo-900 break-all">مشاهده لینک</a>
                            }
                            else
                            {
                                <div class="text-sm font-medium text-gray-900">-</div>
                            }
                        </div>
                    </div>
                </section>

                @if (hasGitDetails)
                {
                    <section class="bg-white border border-gray-200 rounded-lg shadow-sm p-5 md:p-6">
                        <h2 class="text-lg font-semibold text-gray-900 mb-4 flex items-center gap-2">
                            <i class="bi bi-git text-indigo-600"></i>
                            جزئیات فنی و گیت
                        </h2>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="rounded-lg border border-gray-200 p-4">
                                <div class="text-xs text-gray-500 mb-2">Branch</div>
                                <div class="text-sm font-medium text-gray-900 break-all">@EmptyText(Model.Issue.BranchName)</div>
                            </div>
                            <div class="rounded-lg border border-gray-200 p-4">
                                <div class="text-xs text-gray-500 mb-2">نوع آیتم / وضعیت</div>
                                <div class="flex flex-wrap gap-2">
                                    <span class="inline-flex px-2 py-1 rounded-full bg-blue-50 text-blue-700 border border-blue-100 text-xs">@EmptyText(Model.Issue.WorkItemType)</span>
                                    <span class="inline-flex px-2 py-1 rounded-full bg-slate-50 text-slate-700 border border-slate-100 text-xs">@EmptyText(Model.Issue.GitStatus)</span>
                                </div>
                            </div>
                            <div class="rounded-lg border border-gray-200 p-4">
                                <div class="text-xs text-gray-500 mb-2">Repository</div>
                                @if (!string.IsNullOrWhiteSpace(Model.Issue.RepositoryUrl))
                                {
                                    <a href="@Model.Issue.RepositoryUrl" target="_blank" rel="noopener noreferrer" class="text-sm font-medium text-indigo-700 hover:text-indigo-900 break-all">باز کردن repository</a>
                                }
                                else
                                {
                                    <div class="text-sm font-medium text-gray-900">-</div>
                                }
                            </div>
                            <div class="rounded-lg border border-gray-200 p-4">
                                <div class="text-xs text-gray-500 mb-2">Commit / Merge</div>
                                @if (!string.IsNullOrWhiteSpace(Model.Issue.CommitUrl))
                                {
                                    <a href="@Model.Issue.CommitUrl" target="_blank" rel="noopener noreferrer" class="text-sm font-medium text-indigo-700 hover:text-indigo-900 break-all">باز کردن لینک</a>
                                }
                                else
                                {
                                    <div class="text-sm font-medium text-gray-900">-</div>
                                }
                            </div>
                        </div>
                    </section>
                }

                @if (Model.Attachments != null && Model.Attachments.Any())
                {
                    <section class="bg-white border border-gray-200 rounded-lg shadow-sm p-5 md:p-6">
                        <h2 class="text-lg font-semibold text-gray-900 mb-4 flex items-center gap-2">
                            <i class="bi bi-paperclip text-indigo-600"></i>
                            فایل‌های ضمیمه (@Model.Attachments.Count)
                        </h2>
                        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
                            @foreach (var attachment in Model.Attachments)
                            {
                                <div class="border border-gray-200 rounded-lg overflow-hidden">
                                    <div class="p-4">
                                        @if (attachment.IsImage())
                                        {
                                            <a href="@Url.Action("ViewAttachment", "Issues", new { id = attachment.Id })" target="_blank" class="block mb-3">
                                                <img src="@Url.Action("ViewAttachment", "Issues", new { id = attachment.Id })" alt="@attachment.FileName" class="w-full h-44 object-cover rounded-md" />
                                            </a>
                                        }
                                        else if (attachment.IsVideo())
                                        {
                                            <video controls class="w-full h-44 object-cover rounded-md mb-3">
                                                <source src="@Url.Action("ViewAttachment", "Issues", new { id = attachment.Id })" type="@attachment.ContentType">
                                            </video>
                                        }
                                        <strong class="block text-gray-900 text-sm truncate" title="@attachment.FileName">@attachment.FileName</strong>
                                        <small class="text-gray-500 text-xs">@attachment.GetFileSizeDisplay()</small>
                                        <div class="flex gap-2 mt-3">
                                            <a href="@Url.Action("ViewAttachment", "Issues", new { id = attachment.Id })" target="_blank" class="flex-1 inline-flex items-center justify-center gap-1 px-3 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-medium rounded-md">
                                                <i class="bi bi-eye"></i>مشاهده
                                            </a>
                                            <a href="@Url.Action("ViewAttachment", "Issues", new { id = attachment.Id })" download="@attachment.FileName" class="inline-flex items-center justify-center gap-1 px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-800 text-xs font-medium rounded-md">
                                                <i class="bi bi-download"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </section>
                }

                <section class="bg-white border border-gray-200 rounded-lg shadow-sm p-5 md:p-6">
                    <h2 class="text-lg font-semibold text-gray-900 mb-4 flex items-center gap-2">
                        <i class="bi bi-chat-dots text-indigo-600"></i>
                        کامنت‌ها (@Model.Comments.Count)
                    </h2>

                    <div class="space-y-4">
                        @if (Model.Comments.Any())
                        {
                            @foreach (var comment in Model.Comments.OrderBy(c => c.CommentedAt))
                            {
                                <div class="border border-gray-200 rounded-lg p-4">
                                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1 mb-2">
                                        <strong class="text-gray-900">@comment.CommenterFirstName @comment.CommenterLastName</strong>
                                        <small class="text-gray-500 whitespace-nowrap">@comment.CommentedAt.ToString("yyyy/MM/dd HH:mm")</small>
                                    </div>
                                    <p class="text-gray-800 leading-7 whitespace-pre-wrap">@comment.CommentText</p>

                                    @if (Model.CommentAttachments != null && Model.CommentAttachments.ContainsKey(comment.Id) && Model.CommentAttachments[comment.Id].Any())
                                    {
                                        <div class="mt-4 pt-4 border-t border-gray-200 grid grid-cols-1 md:grid-cols-2 gap-3">
                                            @foreach (var attachment in Model.CommentAttachments[comment.Id])
                                            {
                                                <a href="@Url.Action("ViewCommentAttachment", "Issues", new { id = attachment.Id })" target="_blank" class="flex items-center justify-between gap-3 rounded-lg border border-gray-200 px-3 py-2 text-sm text-indigo-700 hover:bg-indigo-50">
                                                    <span class="truncate">@attachment.FileName</span>
                                                    <i class="bi bi-paperclip"></i>
                                                </a>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <div class="bg-blue-50 border-r-4 border-blue-500 text-blue-800 px-4 py-3 rounded-lg text-center">
                                هنوز کامنتی ثبت نشده است.
                            </div>
                        }
                    </div>

                    <form asp-action="AddComment" method="post" enctype="multipart/form-data" class="mt-6 pt-6 border-t border-gray-200">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="issueId" value="@Model.Issue.Id" />
                        <input type="hidden" name="returnUrl" value="@currentDetailsUrl" />
                        <textarea name="commentText" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent" rows="4" placeholder="کامنت خود را وارد کنید..." required maxlength="2000"></textarea>
                        <div class="mt-4 grid grid-cols-1 md:grid-cols-[1fr_auto] gap-3 items-end">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">ضمیمه کامنت</label>
                                <input type="file" name="commentAttachments" accept="image/*" class="w-full px-4 py-2 border border-gray-300 rounded-lg bg-white focus:ring-2 focus:ring-indigo-500 focus:border-transparent" multiple />
                                <p class="mt-2 text-xs text-gray-500">فقط فایل تصویری مجاز است. فرمت‌های قابل قبول: jpg، png، gif، webp و bmp.</p>
                            </div>
                            <button type="submit" class="inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-lg transition-colors duration-200">
                                <i class="bi bi-send"></i>
                                <span>ارسال کامنت</span>
                            </button>
                        </div>
                    </form>
                </section>
            </div>

            @if (showSidePanel)
            {
                <aside class="space-y-6">
                    @if (Model.IsAdmin)
                    {
                        <section class="bg-white border border-gray-200 rounded-lg shadow-sm p-5">
                            <h2 class="text-lg font-semibold text-gray-900 mb-4 flex items-center gap-2">
                                <i class="bi bi-person-gear text-indigo-600"></i>
                                مالکیت و زمان‌ها
                            </h2>
                            <div class="space-y-4 text-sm">
                                <div>
                                    <div class="text-xs text-gray-500 mb-1">ثبت‌کننده</div>
                                    <div class="font-medium text-gray-900">@Model.Issue.ReporterFirstName @Model.Issue.ReporterLastName</div>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(Model.PreviousAssignee))
                                {
                                    <div>
                                        <div class="text-xs text-gray-500 mb-1">مسئول قبلی</div>
                                        <div class="font-medium text-gray-900">@Model.PreviousAssignee</div>
                                    </div>
                                }
                                <div>
                                    <div class="text-xs text-gray-500 mb-1">مسئول</div>
                                    <div class="font-medium text-gray-900">
                                        @if (!string.IsNullOrWhiteSpace(Model.Issue.AssignedToFirstName))
                                        {
                                            @($"{Model.Issue.AssignedToFirstName} {Model.Issue.AssignedToLastName}")
                                        }
                                        else
                                        {
                                            <span class="text-amber-700">بدون مسئول</span>
                                        }
                                    </div>
                                </div>
                                <div class="border-t border-gray-200 pt-4">
                                    <div class="text-xs text-gray-500 mb-1">زمان ثبت</div>
                                    <div class="font-medium text-gray-900 whitespace-nowrap">@FormatDate(Model.Issue.CreatedAt)</div>
                                </div>
                                <div>
                                    <div class="text-xs text-gray-500 mb-1">زمان شروع</div>
                                    <div class="font-medium text-gray-900 whitespace-nowrap">@FormatDate(Model.Issue.StartedAt)</div>
                                </div>
                                <div>
                                    <div class="text-xs text-gray-500 mb-1">زمان پایان</div>
                                    <div class="font-medium text-gray-900 whitespace-nowrap">@FormatDate(Model.Issue.CompletedAt)</div>
                                </div>
                                @if (Model.Issue.DurationMinutes.HasValue)
                                {
                                    <div>
                                        <div class="text-xs text-gray-500 mb-1">مدت انجام</div>
                                        <div class="font-bold text-gray-900">@Model.Issue.GetDurationDisplay()</div>
                                    </div>
                                }
                            </div>
                        </section>
                    }

                    @if (Model.IsAssigned)
                    {
                        <section class="bg-white border border-gray-200 rounded-lg shadow-sm p-5">
                        <h2 class="text-lg font-semibold text-gray-900 mb-4 flex items-center gap-2">
                            <i class="bi bi-flag text-indigo-600"></i>
                            تغییر وضعیت
                        </h2>
                        <form asp-action="UpdateStatus" method="post" class="space-y-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="issueId" value="@Model.Issue.Id" />
                            <input type="hidden" name="returnUrl" value="@currentDetailsUrl" />
                            <select name="status" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent" required>
                                @foreach (var status in Model.StatusOptions)
                                {
                                    <option value="@status" selected="@(Model.Issue.Status == status)">@status</option>
                                }
                            </select>
                            <button type="submit" class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-lg transition-colors duration-200">
                                <i class="bi bi-check-circle"></i>
                                <span>به‌روزرسانی</span>
                            </button>
                        </form>

                        <div class="space-y-2 mt-4 pt-4 border-t border-gray-200 text-sm">
                            <div>
                                <span class="text-gray-500">مسئول: </span>
                                <span class="font-medium text-gray-900">
                                    @(!string.IsNullOrWhiteSpace(Model.Issue.AssignedToFirstName) ? $"{Model.Issue.AssignedToFirstName} {Model.Issue.AssignedToLastName}" : "بدون مسئول")
                                </span>
                            </div>
                            <div>
                                <span class="text-gray-500">ثبت‌کننده: </span>
                                <span class="font-medium text-gray-900">@Model.Issue.ReporterFirstName @Model.Issue.ReporterLastName</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(Model.PreviousAssignee))
                            {
                                <div>
                                    <span class="text-gray-500">مسئول قبلی: </span>
                                    <span class="font-medium text-gray-900">@Model.PreviousAssignee</span>
                                </div>
                            }
                        </div>

                        <form asp-action="QuickAssign" method="post" class="space-y-3 mt-4">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="issueId" value="@Model.Issue.Id" />
                            <input type="hidden" name="returnUrl" value="@currentDetailsUrl" />
                            <label class="block text-sm font-medium text-gray-700">تغییر مسئول</label>
                            <select name="assignedToId" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent">
                                <option value="">بدون مسئول</option>
                                @foreach (var activeUser in Model.ActiveIssueUsers)
                                {
                                    <option value="@activeUser.Id" selected="@(Model.Issue.AssignedToId == activeUser.Id)">@activeUser.FirstName @activeUser.LastName</option>
                                }
                            </select>
                            <button type="submit" class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-gray-800 hover:bg-gray-900 text-white font-medium rounded-lg transition-colors duration-200">
                                <i class="bi bi-person-check"></i>
                                <span>ثبت مسئول</span>
                            </button>
                        </form>
                    </section>
                    }

                    <section class="bg-white border border-gray-200 rounded-lg shadow-sm p-5">
                            <h2 class="text-lg font-semibold text-gray-900 mb-4 flex items-center gap-2">
                                <i class="bi bi-journal-text text-indigo-600"></i>
                                لاگ فعالیت (@Model.Logs.Count)
                            </h2>
                            @if (Model.Logs.Any())
                            {
                                <div class="space-y-3 max-h-96 overflow-y-auto">
                                    @foreach (var log in Model.Logs)
                                    {
                                        var badge = LogActionBadge(log.Action);
                                        <div class="border border-gray-200 rounded-lg p-3">
                                            <div class="flex items-center justify-between gap-2 mb-1">
                                                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full @badge.cssClass">@badge.label</span>
                                                <small class="text-gray-500 whitespace-nowrap">@log.Timestamp.ToString("yyyy/MM/dd HH:mm")</small>
                                            </div>
                                            <div class="text-sm text-gray-800">@log.Description</div>
                                            <div class="mt-1 text-xs text-gray-500">توسط @log.UserFirstName @log.UserLastName</div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="bg-blue-50 border-r-4 border-blue-500 text-blue-800 px-4 py-3 rounded-lg text-center text-sm">
                                    هنوز لاگی برای این مشکل ثبت نشده است.
                                </div>
                            }
                    </section>
                </aside>
            }
        </div>
    </div>
</div>
